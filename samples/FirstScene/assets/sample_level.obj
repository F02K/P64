# P64 sample OBJ with multiple groups.
mtllib sample_level.mtl
o Floor
usemtl Ground
v -3 0 -3
v 3 0 -3
v 3 0 3
v -3 0 3
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 1 0
f 1/1/1 2/2/1 3/3/1 4/4/1
o Door
usemtl Door
v -0.5 0 -1
v 0.5 0 -1
v 0.5 2 -1
v -0.5 2 -1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
f 5/5/2 6/6/2 7/7/2 8/8/2
